PORT=5001
NODE_ENV=development
JWT_SECRET=serp_cloud_secret_key_2026_super_secure_jwt_token
CLIENT_URL=http://localhost:5173

# -------------------------------------------------------------
# Optional Real AWS Cloud Integration Credentials
# (If omitted, system automatically operates in Local Simulation mode)
# -------------------------------------------------------------
USE_AWS=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
DYNAMODB_EVENTS_TABLE=serp-events-production
DYNAMODB_REGISTRATIONS_TABLE=serp-registrations-production
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/serp-ticket-queue-production
AWS_S3_BUCKET=serp-passes-production
AWS_SES_SENDER_EMAIL=tickets@serp.cloud
